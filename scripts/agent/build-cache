#!/usr/bin/env node
// The machine-wide app cache and build slots behind scripts/agent/build-app (logic: scripts/lib/build-cache.mjs).
//
//   scripts/agent/build-cache stamp    --repo R --config C --framework F [--signing default|adhoc]
//   scripts/agent/build-cache restore  --repo R --stamp S --config C --out DIR [--signing S] [--bundle]
//   scripts/agent/build-cache finish   --repo R --app APP --config C --out DIR [--bundle]
//   scripts/agent/build-cache verify-engine --app APP --framework F
//   scripts/agent/build-cache engine   --repo R
//   scripts/agent/build-cache slots    --repo R
//   scripts/agent/build-cache reserve  --owner PID
//   scripts/agent/build-cache slot-run --repo R --slot DIR --stamp S --config C --framework F --out DIR [--signing S]
//                                      [--bundle] [--replace] -- <xcodebuild args…>
//   scripts/agent/build-cache slot-evict [--protect DIR]
//   scripts/agent/build-cache status | evict
//   scripts/agent/build-cache -h | --help
//
// stamp    the native stamp: the content of every file that changes the app's binary (apps/browser/macos,
//          packages/*/ios, the Pods' inputs, patches, pnpm-lock.yaml, packages/core-rs, the ArdiaCore header,
//          scripts/lib/paths.sh), every file of the engine framework staged, the config, the signing, the Xcode
//          toolchain and SDK, and the build-affecting environment (RCT_*, EXPO_*, TOOLCHAINS, CC, …). JS files are
//          not in it. Exits 3 (no reuse) when the build can't be fingerprinted: XCODE_XCCONFIG_FILE or a bundling
//          override (SKIP_BUNDLING, FORCE_BUNDLING, BUNDLE_*, …) set, apps/browser/macos/.xcode.env.local holding more
//          than the NODE_BINARY line pod install writes (that line is in the stamp, and slots use this tree's copy), no
//          framework, no toolchain.
// restore  on a cache hit, APFS-clones one immutable version of the entry (app, hermesc, meta) and checks the copy is
//          whole, then makes DIR/Ardia.app from it (exit 0, prints the app); a miss, or an entry that changed or went
//          away meanwhile, exits 2. Release (or --bundle) swaps in this tree's JS: a fresh main.jsbundle (Hermes for
//          Release, dev JS for Debug, which then ignores Metro) and its assets, and re-signs the app as it was signed.
// finish   the same bundling for an app built in place (build-app --plain --bundle).
// verify-engine  exits 0 when the engine embedded in APP has the code of F (Mach-O UUIDs and every other file, so
//          the re-signing staging does is no difference).
// engine   the prebuilt engine for this tree's engine key, kept once per machine under the cache (fetched on a miss).
// slots    the free build slots, best first (fewest files differing from this tree); `reserve` makes a new one.
// slot-run run under `scripts/agent/locked xcodebuild` (the slot's derived data is its lock): syncs this tree into the
//          slot (only changed files are written, so Xcode stays incremental; a journal keeps an interrupted sync's
//          files managed), runs pnpm install and pod install there when their inputs changed, builds, clones the fresh
//          app into DIR, and only then publishes it to the cache, under the stamp of what was synced and staged, and
//          only when that equals --stamp, the framework didn't change during the build and the app embeds that
//          framework's code ("not recorded" otherwise). Its children run in their own process group, recorded in the
//          slot: a slot whose last owner died with children still running is busy, and the next owner stops them
//          first. A node_modules with links that resolve outside the slot is reinstalled from the pnpm store.
// Cache: $AC_APP_CACHE (default ~/ardia-scratch/app-cache): apps (at most $AC_APP_CACHE_MAX_GB 40 GB and
// $AC_APP_CACHE_MAX_ENTRIES 16), engines ($AC_APP_CACHE_MAX_ENGINES 3) and Xcode's compilation cache; least recently
// used evicted first, nothing used in the last $AC_APP_CACHE_GRACE_MIN (15) minutes. Slots: $AC_BUILD_SLOTS (default
// ~/ardia-scratch/build-slots/<n>), $AC_BUILD_SLOTS_KEEP (3) idle ones kept.
import { execFileSync, spawnSync } from "node:child_process";
import fs from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const lib = await import(join(here, "../lib/build-cache.mjs"));
const { signingIdentity } = await import(join(here, "../lib/app-copy.mjs"));

const argv = process.argv.slice(2);
const dash = argv.indexOf("--");
const passthrough = dash >= 0 ? argv.slice(dash + 1) : [];
const [command, ...rest] = dash >= 0 ? argv.slice(0, dash) : argv;
const flags = {};
for (let i = 0; i < rest.length; i++) {
  if (rest[i] === "--bundle" || rest[i] === "--replace") flags[rest[i].slice(2)] = true;
  else if (rest[i].startsWith("--")) flags[rest[i].slice(2)] = rest[++i];
}
const help = () => {
  const lines = fs.readFileSync(fileURLToPath(import.meta.url), "utf8").split("\n").slice(1);
  console.log(lines.slice(0, lines.findIndex((l) => !l.startsWith("//"))).map((l) => l.replace(/^\/\/ ?/, "")).join("\n"));
};
if (!command || command === "-h" || command === "--help") {
  help();
  process.exit(command ? 0 : 64);
}
const cfg = lib.defaults();
const repo = flags.repo ? resolve(flags.repo) : resolve(here, "../..");
const signing = flags.signing || "default";
const need = (...names) => {
  for (const n of names) if (!flags[n]) throw new Error(`${command} needs --${n}`);
};
const LSREGISTER = "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister";
const NO_METRO = "127.0.0.1:1";
const hashCache = new lib.HashCache(join(cfg.cacheRoot, ".file-hashes.json"));
const quiet = { stdio: ["ignore", "ignore", "inherit"] };

class Miss extends Error {}

function hermescFor(entryDir) {
  for (const path of [entryDir && join(entryDir, "hermesc"), join(repo, "apps/browser/macos/Pods/hermes-engine/destroot/bin/hermesc")]) {
    if (path && fs.existsSync(path)) return path;
  }
  throw new Error("no hermesc: neither the cache entry nor this tree's Pods have one");
}

function bundleInto(outDir, { dev, hermesc }) {
  const rn = join(repo, "node_modules/react-native-macos");
  if (!fs.existsSync(join(rn, "scripts/bundle.js"))) throw new Error(`${repo} has no node_modules: set the tree up before bundling its JS`);
  fs.rmSync(outDir, { recursive: true, force: true });
  fs.mkdirSync(outDir, { recursive: true });
  const js = join(outDir, "main.js");
  const r = spawnSync(
    process.execPath,
    [
      join(rn, "scripts/bundle.js"), "bundle", "--entry-file", "index.js", "--platform", "macos", "--dev", String(dev),
      "--minify", "false", "--bundle-output", js, "--assets-dest", join(outDir, "assets"),
      "--config-cmd", `'${process.execPath}' '${join(rn, "cli.js")}' config`,
    ],
    { cwd: join(repo, "apps/browser"), encoding: "utf8", stdio: ["ignore", "ignore", "pipe"] },
  );
  if (r.status !== 0) throw new Error(`bundling the JS failed:\n${r.stderr.split("\n").slice(-30).join("\n")}`);
  const out = join(outDir, "main.jsbundle");
  if (dev) fs.renameSync(js, out);
  else execFileSync(hermesc, ["-emit-binary", "-max-diagnostic-width=80", "-O", "-out", out, js], quiet);
  return outDir;
}

const signInfo = (path) => spawnSync("codesign", ["-dv", path], { encoding: "utf8" }).stderr;
const hardened = (info) => /flags=0x[0-9a-f]*\([^)]*runtime/.test(info);

function resign(path, scratch, { identity, runtime }) {
  const granted = spawnSync("codesign", ["-d", "--entitlements", "-", "--xml", path], { encoding: "utf8" }).stdout;
  const args = ["--force", "--sign", identity, "--timestamp=none"];
  if (granted && granted.includes("<key>")) {
    fs.mkdirSync(scratch, { recursive: true });
    const plist = join(scratch, `entitlements-${Math.random().toString(36).slice(2)}.plist`);
    fs.writeFileSync(plist, granted);
    args.push("--entitlements", plist);
  }
  if (runtime) args.push("--options", "runtime");
  execFileSync("codesign", [...args, path], quiet);
}

function clearStale(out) {
  const parent = dirname(out);
  const base = out.split("/").pop();
  try {
    for (const name of fs.readdirSync(parent)) {
      if (name.startsWith(`${base}.tmp-`) || name.startsWith(`${base}.snap-`)) fs.rmSync(join(parent, name), { recursive: true, force: true });
    }
  } catch {}
}

function prepare(source, out, opts) {
  const tmp = `${out}.tmp-${process.pid}`;
  try {
    return prepareIn(tmp, source, out, opts);
  } catch (e) {
    fs.rmSync(tmp, { recursive: true, force: true });
    throw e;
  }
}

function prepareIn(tmp, source, out, { config, bundle, hermesc }) {
  fs.rmSync(tmp, { recursive: true, force: true });
  fs.mkdirSync(tmp, { recursive: true });
  const app = join(tmp, "Ardia.app");
  const r = lib.cloneTree(source, app);
  if (r.status !== 0) throw new Error(`copying ${source} failed: ${r.stderr.trim()}`);
  if (bundle) {
    const dev = config !== "Release";
    const built = bundleInto(join(tmp, ".bundle"), { dev, hermesc: dev ? null : hermesc() });
    const resources = join(app, "Contents/Resources");
    fs.copyFileSync(join(built, "main.jsbundle"), join(resources, "main.jsbundle"));
    const assets = join(built, "assets");
    fs.rmSync(join(resources, "assets"), { recursive: true, force: true });
    if (fs.existsSync(assets) && fs.readdirSync(assets).length) {
      const c = lib.cloneTree(assets, join(resources, "assets"));
      if (c.status !== 0) throw new Error(`copying the assets failed: ${c.stderr.trim()}`);
    }
    if (dev) fs.writeFileSync(join(resources, "ip.txt"), `${NO_METRO}\n`);
    fs.rmSync(built, { recursive: true, force: true });
    resign(app, join(tmp, ".sign"), { identity: signingIdentity(app), runtime: hardened(signInfo(app)) });
    fs.rmSync(join(tmp, ".sign"), { recursive: true, force: true });
  }
  fs.rmSync(out, { recursive: true, force: true });
  fs.renameSync(tmp, out);
  const final = join(out, "Ardia.app");
  spawnSync(LSREGISTER, ["-u", final], { stdio: "ignore" });
  return final;
}

function inputsFor(framework) {
  const inputs = lib.stampInputs({ framework, hashCache, repo });
  hashCache.save();
  return inputs;
}

function stampFor(manifest, inputs) {
  return lib.stampOf({ manifest, config: flags.config, signing, ...inputs });
}

let groupSlot = null;
const GROUP_WRAPPER = 'setpgrp(0, 0); my $f = shift; open(my $h, ">", $f) or die "$f: $!"; print $h "{\\"pgid\\":$$}"; close $h; exec { $ARGV[0] } @ARGV or die "exec $ARGV[0]: $!";';

function sh(cmd, args, opts) {
  console.log(`build-cache: ${[cmd, ...args].join(" ")}`);
  const wrapped = groupSlot ? ["perl", ["-e", GROUP_WRAPPER, lib.slotGroupFile(groupSlot), cmd, ...args]] : [cmd, args];
  const r = spawnSync(wrapped[0], wrapped[1], { stdio: "inherit", ...opts });
  return r.status ?? 1;
}

function reapGroup(slot) {
  const pgid = lib.slotGroup(slot);
  if (lib.groupAlive(pgid)) {
    console.log(`build-cache: stopping process group ${pgid} left running in ${slot} by a build that died`);
    for (const [signal, wait] of [["SIGTERM", 10], ["SIGKILL", 5]]) {
      try {
        process.kill(-pgid, signal);
      } catch {}
      for (let i = 0; i < wait * 10 && lib.groupAlive(pgid); i++) spawnSync("sleep", ["0.1"]);
      if (!lib.groupAlive(pgid)) break;
    }
    if (lib.groupAlive(pgid)) throw new Error(`process group ${pgid} in ${slot} won't stop`);
  }
  fs.rmSync(lib.slotGroupFile(slot), { force: true });
}

function pnpmCommand() {
  const r = spawnSync("sh", ["-c", "command -v pnpm"], { encoding: "utf8" });
  return r.status === 0 ? [r.stdout.trim()] : ["corepack", "pnpm"];
}

function removeNodeModules(tree) {
  for (const rel of lib.nodeModulesRoots(tree)) fs.rmSync(join(tree, rel), { recursive: true, force: true });
}

function syncDeps(slot, state, manifest) {
  const tree = lib.slotTree(slot);
  const deps = lib.depsHash(manifest);
  const pods = lib.podsHash(manifest);
  const next = { ...state };
  const modules = join(tree, "node_modules/.modules.yaml");
  const modulesChanged = fs.existsSync(modules) && fs.statSync(modules).mtimeMs > (state.linksCheckedAt ?? 0);
  const escaping = lib.escapingLinks(tree, { deep: modulesChanged });
  if (escaping.length) {
    console.log(`build-cache: the slot's node_modules links outside it (${escaping[0]}); reinstalling it from the pnpm store`);
    removeNodeModules(tree);
    next.deps = null;
  }
  if (next.deps !== deps || !fs.existsSync(join(tree, "node_modules/.modules.yaml"))) {
    if (!fs.existsSync(join(tree, "node_modules")) && fs.existsSync(join(repo, "node_modules"))) {
      const roots = lib.nodeModulesRoots(repo);
      console.log(`build-cache: seeding node_modules from ${repo} (${roots.length} folders, APFS clones)`);
      for (const rel of roots) {
        const r = lib.cloneTree(join(repo, rel), join(tree, rel));
        if (r.status !== 0) throw new Error(`seeding ${rel} failed: ${r.stderr.trim()}`);
      }
      const outside = lib.escapingLinks(tree, { deep: true, limit: 1 });
      if (outside.length) {
        console.log(`build-cache: the seeded node_modules links outside the slot (${outside[0]}); installing from the pnpm store instead`);
        removeNodeModules(tree);
      }
    }
    lib.writeSlotState(slot, { ...lib.readSlotState(slot), deps: null, pods: null });
    const [pnpm, ...pre] = pnpmCommand();
    const base = [...pre, "install", "--frozen-lockfile", "--config.confirmModulesPurge=false"];
    if (sh(pnpm, [...base, "--offline"], { cwd: tree }) !== 0 && sh(pnpm, base, { cwd: tree }) !== 0) {
      throw new Error("pnpm install failed in the slot");
    }
    const after = lib.escapingLinks(tree, { deep: true, limit: 1 });
    if (after.length) throw new Error(`the slot's node_modules links outside it after pnpm install (${after[0]})`);
    next.deps = deps;
    next.pods = null;
    next.linksCheckedAt = Date.now();
  } else if (modulesChanged) next.linksCheckedAt = Date.now();
  if (next.pods !== pods || !fs.existsSync(join(tree, "apps/browser/macos/Pods/Manifest.lock"))) {
    next.pods = null;
    lib.writeSlotState(slot, { ...lib.readSlotState(slot), deps: next.deps, pods: null });
    if (sh("pod", ["install"], { cwd: join(tree, "apps/browser/macos") }) !== 0) throw new Error("pod install failed in the slot");
    next.pods = pods;
  }
  return next;
}

function engineMatches(app, framework) {
  const embedded = join(app, "Contents/Frameworks/Chromium Framework.framework");
  try {
    return lib.codeDigest(embedded, hashCache) === lib.codeDigest(framework, hashCache);
  } catch {
    return false;
  } finally {
    hashCache.save();
  }
}

function headOf(dir) {
  const r = spawnSync("git", ["-C", dir, "rev-parse", "HEAD"], { encoding: "utf8" });
  return r.status === 0 ? r.stdout.trim() : null;
}

function slotRun() {
  need("slot", "stamp", "config", "out", "framework");
  const slot = resolve(flags.slot);
  const tree = lib.slotTree(slot);
  lib.releaseReservation(slot);
  reapGroup(slot);
  groupSlot = slot;
  let manifest;
  for (let attempt = 1; ; attempt++) {
    const started = Date.now();
    manifest = lib.manifestOf(repo, lib.listFiles(repo));
    const { changed, removed, drifted, mismatched } = lib.syncTree(repo, slot, manifest);
    console.log(`build-cache: synced ${repo} into ${tree}: ${changed.length} written, ${removed.length} removed, ${drifted.length} drifted (${Date.now() - started} ms)`);
    for (const rel of changed.slice(0, 20)) console.log(`  + ${rel}`);
    if (!mismatched.length) break;
    if (attempt === 3) throw new Error(`${mismatched.length} files kept changing while they were synced (${mismatched[0]})`);
  }
  const state = syncDeps(slot, lib.readSlotState(slot), manifest);
  for (const rel of lib.UNFINGERPRINTABLE_FILES) {
    if (fs.existsSync(join(repo, rel))) fs.copyFileSync(join(repo, rel), join(tree, rel));
    else fs.rmSync(join(tree, rel), { force: true });
  }
  lib.writeSlotState(slot, { ...lib.readSlotState(slot), deps: state.deps, pods: state.pods, linksCheckedAt: state.linksCheckedAt, repo, head: headOf(repo) });
  const before = inputsFor(flags.framework);
  const synced = before.blocked ? null : stampFor(manifest, before);
  console.log(`build-cache: stamp ${synced ?? "none"}${before.blocked ? ` (${before.blocked})` : ""}`);
  const status = sh("xcodebuild", passthrough, { cwd: join(tree, "apps/browser") });
  fs.rmSync(lib.slotGroupFile(slot), { force: true });
  if (status !== 0) process.exit(status);
  const product = join(lib.slotDerivedData(slot), "Build/Products", flags.config, "Ardia.app");
  clearStale(resolve(flags.out));
  const app = prepare(product, resolve(flags.out), {
    config: flags.config,
    bundle: flags.bundle && flags.config !== "Release",
    hermesc: () => hermescFor(null),
  });
  console.log(`build-cache: app ${app}`);
  const after = inputsFor(flags.framework);
  const unrecorded = after.framework !== before.framework
    ? "the engine framework changed during the build"
    : !engineMatches(product, flags.framework)
      ? "the engine embedded in the app isn't the one hashed"
      : null;
  if (unrecorded) {
    console.log(`build-cache: not recorded: ${unrecorded}`);
    return;
  }
  const reason = !synced
    ? before.blocked
    : synced !== flags.stamp
      ? `the synced tree's stamp ${synced.slice(0, 12)} isn't the requested ${flags.stamp.slice(0, 12)} (the tree changed while waiting)`
      : null;
  if (reason) {
    console.log(`build-cache: not cached: ${reason}`);
    return;
  }
  try {
    const entry = lib.store(cfg.cacheRoot, synced, product, { config: flags.config, repo, head: headOf(repo), slot }, {
      replace: !!flags.replace,
      hermesc: join(tree, "apps/browser/macos/Pods/hermes-engine/destroot/bin/hermesc"),
    });
    lib.evict(cfg.cacheRoot, { maxBytes: cfg.maxBytes, maxEntries: cfg.maxEntries, keepEngines: cfg.keepEngines, graceMs: cfg.graceMs, protect: [synced] });
    console.log(`build-cache: cached ${entry.dir}`);
  } catch (e) {
    console.log(`build-cache: not cached: publishing failed (${e.message}); the app above is fine`);
  }
}

function engine() {
  const key = engineKey();
  const dir = join(cfg.cacheRoot, "engines", key.slice(0, 12));
  const framework = join(dir, "Chromium Framework.framework");
  if (!fs.existsSync(join(dir, ".complete"))) {
    const fetched = execFileSync(join(repo, "packages/ardiacore/scripts/fetch-engine.sh"), { encoding: "utf8", stdio: ["ignore", "pipe", "inherit"] }).trim();
    const tmp = `${dir}.tmp-${process.pid}`;
    fs.rmSync(tmp, { recursive: true, force: true });
    fs.mkdirSync(tmp, { recursive: true });
    const r = lib.cloneTree(fetched, join(tmp, "Chromium Framework.framework"));
    if (r.status !== 0) throw new Error(`copying the engine failed: ${r.stderr.trim()}`);
    fs.writeFileSync(join(tmp, ".complete"), "");
    try {
      fs.renameSync(tmp, dir);
    } catch {
      fs.rmSync(tmp, { recursive: true, force: true });
    }
    if (!fs.existsSync(join(dir, ".complete")) || !fs.existsSync(join(framework, "Versions/Current/Chromium Framework"))) {
      throw new Error(`the engine store ${dir} is incomplete after fetching`);
    }
  }
  lib.touch(dir);
  lib.evict(cfg.cacheRoot, { maxBytes: cfg.maxBytes, maxEntries: cfg.maxEntries, keepEngines: cfg.keepEngines, graceMs: cfg.graceMs, protectEngines: [dir] });
  return framework;
}

function engineKey() {
  const r = spawnSync(join(repo, "engine/engine-key.sh"), ["--platform", "macos"], { encoding: "utf8" });
  if (r.status !== 0) throw new Error("engine/engine-key.sh failed");
  return r.stdout.trim();
}

function slotEvict() {
  const locked = join(here, "locked");
  const protect = flags.protect ? [resolve(flags.protect)] : [];
  for (const slot of lib.slotsToEvict(cfg.slotRoot, { keep: cfg.keepSlots, protect })) {
    const trash = join(cfg.slotRoot, `.trash-${process.pid}-${slot.split("/").pop()}`);
    const r = spawnSync(locked, ["xcodebuild", "--wait", "2", "--", "sh", "-c", 'mv "$1" "$2"', "-", slot, trash, "-derivedDataPath", lib.slotDerivedData(slot)], { encoding: "utf8" });
    if (r.status === 0 && fs.existsSync(trash)) {
      spawnSync("rm", ["-rf", trash]);
      console.log(`build-cache: dropped idle slot ${slot}`);
    }
  }
}

try {
  if (command === "stamp") {
    need("config");
    const inputs = inputsFor(flags.framework);
    if (inputs.blocked) {
      console.error(`build-cache: no reuse: ${inputs.blocked}`);
      process.exit(3);
    }
    console.log(stampFor(lib.manifestOf(repo, lib.listFiles(repo).filter(lib.isNative)), inputs));
  } else if (command === "restore") {
    need("stamp", "config", "out");
    const out = resolve(flags.out);
    clearStale(out);
    const entry = lib.lookup(cfg.cacheRoot, flags.stamp);
    if (!entry || !lib.touch(entry.dir)) throw new Miss("no cache entry");
    const snapDir = `${out}.snap-${process.pid}`;
    const snap = lib.snapshotEntry(entry, snapDir);
    if (!snap) {
      fs.rmSync(snapDir, { recursive: true, force: true });
      throw new Miss("the cache entry changed or went away while it was copied");
    }
    const bundle = flags.bundle || flags.config === "Release";
    try {
      console.log(prepare(snap.app, out, { config: flags.config, bundle, hermesc: () => snap.hermesc ?? hermescFor(null) }));
    } finally {
      fs.rmSync(snapDir, { recursive: true, force: true });
    }
    console.log(`from ${snap.meta.head?.slice(0, 10) ?? "?"} built ${snap.meta.created}`);
  } else if (command === "verify-engine") {
    need("app", "framework");
    process.exit(engineMatches(resolve(flags.app), resolve(flags.framework)) ? 0 : 1);
  } else if (command === "finish") {
    need("app", "config", "out");
    console.log(prepare(resolve(flags.app), resolve(flags.out), { config: flags.config, bundle: !!flags.bundle && flags.config !== "Release", hermesc: () => hermescFor(null) }));
  } else if (command === "engine") {
    console.log(engine());
  } else if (command === "slots") {
    const manifest = lib.manifestOf(repo, lib.listFiles(repo));
    for (const slot of lib.freeSlots(cfg.slotRoot, manifest)) console.log(slot);
  } else if (command === "reserve") {
    need("owner");
    console.log(lib.reserveSlot(cfg.slotRoot, Number(flags.owner)));
  } else if (command === "slot-run") {
    slotRun();
  } else if (command === "slot-evict") {
    slotEvict();
  } else if (command === "evict") {
    const plan = lib.evict(cfg.cacheRoot, { maxBytes: cfg.maxBytes, maxEntries: cfg.maxEntries, keepEngines: cfg.keepEngines, graceMs: cfg.graceMs });
    console.log(`kept ${plan.keep.length} (${(plan.bytes / 1024 ** 3).toFixed(1)} GB), evicted ${plan.evict.length} apps and ${plan.engines.length} engines`);
  } else if (command === "status") {
    for (const e of lib.entries(cfg.cacheRoot)) {
      console.log(`app  ${e.stamp}  ${e.meta.config}  ${(e.bytes / 1024 ** 3).toFixed(2)} GB  ${e.meta.head?.slice(0, 10) ?? "?"}  used ${new Date(e.usedAt).toISOString()}`);
    }
    for (const slot of lib.listSlots(cfg.slotRoot)) {
      const s = lib.readSlotState(slot);
      console.log(`slot ${slot}  ${lib.slotBusy(slot) ? "busy" : "free"}  ${s.head?.slice(0, 10) ?? "?"}  synced ${s.syncedAt ? new Date(s.syncedAt).toISOString() : "never"}`);
    }
  } else {
    help();
    process.exit(64);
  }
} catch (e) {
  if (e instanceof Miss) {
    console.error(`build-cache: ${e.message}`);
    process.exit(2);
  }
  console.error(`build-cache: error: ${e.message}`);
  process.exit(1);
}
