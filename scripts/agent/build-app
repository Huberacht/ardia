#!/bin/bash
# Builds the app quietly: the full log goes to a file, and you see only what you need.
#
#   scripts/agent/build-app [--as NAME] [--config Debug|Release] [--force] [--plain|--slot] [--adhoc] [--bundle]
#                           [--prebuilt-engine] [--wait SECS]
#   scripts/agent/build-app -h | --help
#
# --as NAME          your agent name (default: $AC_LOCKED_AS, else "dev"). Its derived data is apps/browser/build-NAME,
#                    and it is passed to `locked` so a chromium take of yours covers the engine staging.
# --config           Debug (default) or Release.
# --force            build even when no native file changed, and skip the app cache.
# --plain            build in this tree's own derived data (apps/browser/build-NAME), as before the cache and slots:
#                    no cache lookup.
# --slot             build in a shared build slot even when this tree's own derived data holds a build.
# --adhoc            sign ad hoc (no provisioning profile; entitlements without com.apple.developer.* and keychain
#                    groups), for a Mac that isn't in the team's profile. Passkeys and keychain groups don't work in it.
#                    It builds without the hardened runtime, so the team-signed Sparkle loads in an ad hoc Release.
# --bundle           Debug: embed this tree's JS (a dev bundle) and turn Metro off, so `ac launch --js none` runs it.
#                    Kept apart from the Metro app (build-NAME/Prebuilt/Debug-bundle).
# --prebuilt-engine  use the published engine for this tree's engine key (kept once per machine) instead of the local
#                    ~/chromium-build framework. Without either, a Mac with no local framework uses the published one.
# --wait SECS        how long to wait for a pod install, or for a busy derived data or slot (default 1500).
#
# How it gets an app, fastest first:
# 1. JS-only (Debug, Metro): no native file differs from the last app this derived data got, so it prints
#    "JS-only: Metro reloads it; no build needed" and that app. --force or --bundle goes on.
# 2. The app cache (scripts/agent/build-cache; not with --plain or --force): every slot build publishes its app under
#    its native stamp (the content of every file that changes the binary, every file of the engine framework, the
#    config, the signing, the toolchain and SDK and the build-affecting environment; never the JS). A tree whose stamp
#    was built on this Mac, in any worktree, gets an APFS clone in a second or two at build-NAME/Prebuilt/<config>:
#    Debug runs the JS Metro serves; Release (and --bundle) gets this tree's JS bundled and swapped in. With
#    XCODE_XCCONFIG_FILE set the build can't be fingerprinted, so nothing is reused or published.
# 3. A build. With no earlier build in build-NAME (or with --slot) it builds in a build slot: a fixed-path copy of a
#    tree (~/ardia-scratch/build-slots/<n>) with its own node_modules, Pods and derived data. Only the files that
#    differ are written into it, so Xcode stays incremental across worktrees: a tree near the slot's last build
#    compiles what changed, not all 1040 files. Each slot is its own `locked xcodebuild` lock; a busy one is skipped
#    and a new slot reserved when none is free. You always get the app that slot build made; it is published to the
#    cache only under the stamp of what was synced, so an edit made while waiting is never cached under the old one,
#    and only when the app embeds the engine that was hashed.
# Runs with one --as and config take turns (a lock per build-NAME and variant). Before a build touches an app, its
# record goes, and is written again only when the build succeeds.
#    Slot builds share Xcode's compilation cache (a CAS under the app cache, slot paths prefix-mapped), so a new slot
#    or a settings change replays compiles instead of redoing them; AC_COMPILE_CACHE=0 turns it off. Otherwise
#    (--plain, or build-NAME holds a build) it builds there as before.
# Prints the errors (a failed build script with its last 30 lines), the warnings count, the result, the time and
# `app: <path>` on its own line (scripts/agent/train reads it). The full log: <derived data>/build-app.log.
# Run it with run_in_background. Exits 0 when built (or nothing to build), 1 when the build failed, 75 when a lock
# stayed busy.
set -uo pipefail

help() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit 0
}
usage() {
  sed -n '4,6p' "$0" | sed 's/^# *//' >&2
  exit 64
}

original_args=("$@")
name=${AC_LOCKED_AS:-dev} config=Debug force="" wait=1500 mode=auto adhoc="" bundle="" prebuilt_engine=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help) help ;;
    --force) force=1; shift; continue ;;
    --plain) mode=plain; shift; continue ;;
    --slot) mode=slot; shift; continue ;;
    --adhoc) adhoc=1; shift; continue ;;
    --bundle) bundle=1; shift; continue ;;
    --prebuilt-engine) prebuilt_engine=1; shift; continue ;;
  esac
  [[ $# -ge 2 ]] || { echo "build-app: $1 needs a value" >&2; usage; }
  case "$1" in
    --as) name="$2" ;;
    --config) config="$2" ;;
    --wait) wait="$2" ;;
    *) echo "build-app: unknown option $1" >&2; usage ;;
  esac
  shift 2
done
[[ "$config" == Debug || "$config" == Release ]] || { echo "build-app: --config is Debug or Release" >&2; usage; }
[[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "build-app: --as takes letters, digits, . _ -" >&2; usage; }

repo=$(cd "$(dirname "$0")/../.." && pwd)
. "$repo/scripts/lib/paths.sh"
cache_tool="$repo/scripts/agent/build-cache"
app_dir="$repo/apps/browser"
dd="$app_dir/build-$name"
log="$dd/build-app.log"
variant=$config
[[ -n "$bundle" && $config == Debug ]] && variant=$config-bundle
[[ $config == Release ]] && bundle=""
prebuilt_out="$dd/Prebuilt/$variant"
stamp_file="$dd/.ac-native-stamp-$variant"
app_file="$dd/.ac-app-$variant"
kind_file="$dd/.ac-kind-$variant"
mkdir -p "$dd"
if [[ "${AC_BUILD_APP_HELD:-}" != "$dd/$variant" ]]; then
  AC_BUILD_APP_HELD="$dd/$variant" exec lockf -k -t "$wait" "$dd/.build-app-$variant.lock" "$0" ${original_args[@]+"${original_args[@]}"}
fi

prebuilt_engine() {
  ARDIACORE_FRAMEWORK=$("$cache_tool" engine --repo "$repo") || { echo "build-app: couldn't fetch the prebuilt engine" >&2; exit 1; }
  export ARDIACORE_FRAMEWORK
}
if [[ -n "$prebuilt_engine" ]]; then
  prebuilt_engine
elif [[ -z "${ARDIACORE_FRAMEWORK:-}" ]]; then
  if [[ -d "$chromium_framework" ]]; then export ARDIACORE_FRAMEWORK=$chromium_framework; else prebuilt_engine; fi
fi
signing=default
[[ -n "$adhoc" ]] && signing=adhoc

stamp=$("$cache_tool" stamp --repo "$repo" --config "$config" --signing "$signing" --framework "$ARDIACORE_FRAMEWORK" 2>"$log.stamp")
case $? in
  0) reuse=1 ;;
  3) reuse="" stamp="" mode=plain; echo "build-app: $(sed 's/^build-cache: //' "$log.stamp"); building in place, without the app cache" ;;
  *) cat "$log.stamp" >&2; echo "build-app: couldn't hash the native files" >&2; exit 1 ;;
esac
last_app=$(cat "$app_file" 2>/dev/null)
[[ $mode == plain && "$(cat "$kind_file" 2>/dev/null)" != plain ]] && last_app=""
if [[ -n "$reuse" && -z "$force$bundle" && $config == Debug && -n "$last_app" && -d "$last_app" && -f "$stamp_file" && "$(cat "$stamp_file")" == "$stamp" ]]; then
  echo "JS-only: Metro reloads it; no build needed (no native file changed since $last_app was built; --force builds anyway)"
  echo "app: $last_app"
  exit 0
fi

record() {
  rm -f "$stamp_file" "$app_file" "$kind_file"
  echo "$2" >"$app_file"
  echo "$3" >"$kind_file"
  [[ -n "$1" ]] && echo "$1" >"$stamp_file"
}

start=$(date +%s)
if [[ -n "$reuse" && -z "$force" && $mode != plain ]]; then
  restore_args=(restore --repo "$repo" --stamp "$stamp" --config "$config" --out "$prebuilt_out" --signing "$signing")
  [[ -n "$bundle" ]] && restore_args+=(--bundle)
  restored=$("$cache_tool" "${restore_args[@]}" 2>"$log.restore")
  status=$?
  if [[ $status -eq 0 ]]; then
    app=$(head -1 <<<"$restored")
    record "$stamp" "$app" cache
    echo "CACHE HIT (stamp ${stamp:0:12}, $(sed -n 2p <<<"$restored")) in $(($(date +%s) - start))s"
    echo "app: $app"
    exit 0
  fi
  if [[ $status -ne 2 ]]; then
    cat "$log.restore" >&2
    echo "build-app: the cached app for stamp ${stamp:0:12} couldn't be restored" >&2
    exit 1
  fi
fi

settings=()
if [[ -n "$adhoc" ]]; then
  signing_dir="${AC_APP_CACHE:-$HOME/ardia-scratch/app-cache}/signing"
  mkdir -p "$signing_dir"
  entitlements=$(python3 -c '
import hashlib, os, plistlib, sys
d = plistlib.load(open(sys.argv[1], "rb"))
d = {k: v for k, v in d.items() if not k.startswith("com.apple.developer.") and k != "keychain-access-groups"}
data = plistlib.dumps(d)
path = os.path.join(sys.argv[2], "adhoc-%s.entitlements" % hashlib.sha256(data).hexdigest()[:12])
if not os.path.exists(path):
    open(path + ".tmp", "wb").write(data)
    os.replace(path + ".tmp", path)
print(path)
' "$app_dir/macos/Ardia-macOS/Ardia.entitlements" "$signing_dir") || { echo "build-app: couldn't write the ad hoc entitlements" >&2; exit 1; }
  settings=(CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER= ENABLE_HARDENED_RUNTIME=NO
    "CODE_SIGN_ENTITLEMENTS=$entitlements")
fi

if [[ $mode == auto ]]; then
  mode=slot
  [[ -d "$dd/Build/Products/$config/Ardia.app" ]] && mode=plain
fi

slot="" built_stamp=$stamp
rm -f "$stamp_file" "$app_file" "$kind_file"
if [[ $mode == plain ]]; then
  echo "build-app: $config into ${dd#"$repo"/} (log: ${log#"$repo"/})"
  (
    cd "$app_dir" &&
      "$repo/scripts/agent/locked" xcodebuild --wait "$wait" --as "$name" -- \
        xcodebuild -workspace macos/Ardia.xcworkspace -scheme Ardia-macOS -derivedDataPath "$dd" \
        -destination 'platform=macOS,arch=arm64' -configuration "$config" -hideShellScriptEnvironment \
        ${settings[@]+"${settings[@]}"} build
  ) >"$log" 2>&1
  status=$?
  app="$dd/Build/Products/$config/Ardia.app"
  if [[ $status -eq 0 && -n "$built_stamp" ]]; then
    after=$("$cache_tool" stamp --repo "$repo" --config "$config" --signing "$signing" --framework "$ARDIACORE_FRAMEWORK" 2>/dev/null)
    if [[ "$after" != "$built_stamp" ]]; then
      echo "build-app: not recorded: the native files or the engine changed during the build"
      built_stamp=""
    elif ! "$cache_tool" verify-engine --app "$app" --framework "$ARDIACORE_FRAMEWORK"; then
      echo "build-app: not recorded: the engine embedded in the app isn't the one hashed"
      built_stamp=""
    fi
  fi
  if [[ $status -eq 0 && -n "$bundle" ]]; then
    app=$("$cache_tool" finish --repo "$repo" --app "$app" --config "$config" --out "$prebuilt_out" --bundle 2>>"$log") || status=1
  fi
else
  echo "build-app: $config in a build slot (log: ${log#"$repo"/})"
  candidates=()
  while IFS= read -r line; do candidates+=("$line"); done < <("$cache_tool" slots --repo "$repo")
  slot_args=(--signing "$signing" --framework "$ARDIACORE_FRAMEWORK")
  [[ -n "$bundle" ]] && slot_args+=(--bundle)
  [[ -n "$force" ]] && slot_args+=(--replace)
  status=75 reserved=""
  i=0
  while :; do
    if [[ $i -lt ${#candidates[@]} ]]; then
      slot=${candidates[$i]}
      try_wait=2
    elif [[ -z "$reserved" ]]; then
      slot=$("$cache_tool" reserve --owner $$) || { echo "build-app: couldn't make a build slot" >&2; exit 1; }
      reserved=$slot try_wait=$wait
    else
      break
    fi
    i=$((i + 1))
    slot_dd="$slot/ardia/apps/browser/build-slot"
    mkdir -p "$slot_dd"
    compile_cache=()
    if [[ "${AC_COMPILE_CACHE:-1}" != 0 ]]; then
      compile_cache=(COMPILATION_CACHE_ENABLE_CACHING=YES "COMPILATION_CACHE_CAS_PATH=${AC_APP_CACHE:-$HOME/ardia-scratch/app-cache}/xcode-cas"
        CLANG_ENABLE_PREFIX_MAPPING=YES SWIFT_ENABLE_PREFIX_MAPPING=YES
        "CLANG_OTHER_PREFIX_MAPPINGS=$slot/ardia=/^repo $slot_dd=/^dd" "SWIFT_OTHER_PREFIX_MAPPINGS=$slot/ardia=/^repo $slot_dd=/^dd")
    fi
    (
      cd "$app_dir" &&
        "$repo/scripts/agent/locked" xcodebuild --wait "$try_wait" --as "$name" -- \
          "$cache_tool" slot-run --repo "$repo" --slot "$slot" --stamp "${stamp:-none}" --config "$config" --out "$prebuilt_out" \
          "${slot_args[@]}" -- \
          -workspace macos/Ardia.xcworkspace -scheme Ardia-macOS -derivedDataPath "$slot_dd" \
          -destination 'platform=macOS,arch=arm64' -configuration "$config" -hideShellScriptEnvironment \
          ${settings[@]+"${settings[@]}"} ${compile_cache[@]+"${compile_cache[@]}"} build
    ) >"$log" 2>&1
    status=$?
    [[ $status -eq 75 && -z "$reserved" ]] && continue
    break
  done
  [[ -n "$reserved" && $status -eq 75 ]] && rm -f "$reserved/reserved.json"
  (nohup "$cache_tool" slot-evict --protect "$slot" >/dev/null 2>&1 &)
  app="$prebuilt_out/Ardia.app"
  built_stamp=$(sed -n 's/^build-cache: stamp \([0-9a-f]\{32\}\).*/\1/p' "$log" | tail -1)
  grep -q '^build-cache: not cached' "$log" && echo "$(grep -m1 '^build-cache: not cached' "$log" | sed 's/^build-cache: //')"
  if grep -q '^build-cache: not recorded' "$log"; then
    grep -m1 '^build-cache: not recorded' "$log" | sed 's/^build-cache: //'
    built_stamp=""
  fi
  synced=$(grep '^build-cache: synced' "$log" | tail -1 | sed -E 's/.*: ([0-9]+) written, ([0-9]+) removed.*/\1 files written, \2 removed/')
  echo "slot: $slot${synced:+ ($synced)}"
fi
elapsed=$(($(date +%s) - start))

python3 - "$log" <<'PY'
import re, sys
lines = open(sys.argv[1], errors="replace").read().split("\n")
seen, errors = set(), []
for line in lines:
    if re.search(r"(^|\s)(fatal )?error:|^locked: ", line) and "MACOSX_DEPLOYMENT_TARGET" not in line:
        key = line.strip()
        if key not in seen:
            seen.add(key)
            errors.append(key)
for line in errors[:40]:
    print(line)
if len(errors) > 40:
    print(f"… {len(errors) - 40} more errors in the log")
failed = []
if "The following build commands failed:" in lines:
    i = lines.index("The following build commands failed:") + 1
    while i < len(lines) and lines[i].startswith("\t"):
        failed.append(lines[i].strip())
        i += 1
for command in failed:
    if not command.startswith(("(", "Building workspace")):
        print("failed: " + command)
    m = re.match(r"PhaseScriptExecution (.*?\.sh)", command)
    if not m:
        continue
    head = "PhaseScriptExecution " + m.group(1)
    starts = [i for i, l in enumerate(lines) if l.startswith(head)]
    if not starts:
        continue
    block = []
    for l in lines[starts[-1] + 1:]:
        if l.startswith("** ") or (block and block[-1] == "" and re.match(r"^[A-Z][A-Za-z]+ ", l)):
            break
        block.append(l)
    body = [l for l in block if not l.startswith("    ")]
    while body and body[-1] == "":
        body.pop()
    print("  last 30 lines of its output:")
    for l in body[-30:]:
        print("    " + l)
PY
warnings=$(grep -E '(^|[[:space:]])warning:' "$log" | grep -v MACOSX_DEPLOYMENT_TARGET | sort -u | wc -l | tr -d ' ')
duration="$((elapsed / 60))m $((elapsed % 60))s"
if [[ $status -eq 0 ]] && grep -q '\*\* BUILD SUCCEEDED \*\*' "$log" && [[ -d "$app" ]]; then
  record "$built_stamp" "$app" "$mode"
  echo "warnings: $warnings"
  echo "BUILD SUCCEEDED in $duration"
  echo "app: $app"
  exit 0
fi
echo "warnings: $warnings"
if [[ $status -eq 75 ]]; then
  echo "NOT BUILT: a lock stayed busy for ${wait}s (above); nothing was built"
  exit 75
fi
echo "BUILD FAILED in $duration (full log: $log)"
exit 1
